# Copy to .env and fill in real values before running aio app run / aio app deploy

# Adobe I/O Runtime namespace (set automatically by aio app use)
# AIO_RUNTIME_NAMESPACE=
# AIO_RUNTIME_AUTH=

# Adobe Analytics — API key (Client ID) of the OAuth Server-to-Server credential.
# Referenced by the `analytics` action's `apiKey: $SERVICE_API_KEY` input.
# The S2S client secret / scopes are injected automatically by
# `include-ims-credentials: true` (params.__ims_oauth_s2s) — no extra vars needed.
SERVICE_API_KEY=
